{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www\\.milchiscatalin\\.com" }],
      "destination": "https://milchiscatalin.com/:path*",
      "permanent": true
    },
    {
      "source": "/posts/cc1101-packet-mode-and-raw-capture",
      "destination": "/posts/sub-ghz-radio-cc1101-basics",
      "permanent": true
    },
    {
      "source": "/posts/cc1101-packet-mode-and-raw-capture.html",
      "destination": "/posts/sub-ghz-radio-cc1101-basics",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'none'" }
      ]
    }
  ]
}
