# Dependencies
node_modules/
frontend/node_modules/

# Next.js build output
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/

# Generated TypeScript artifacts
frontend/next-env.d.ts
frontend/*.tsbuildinfo

# Next.js agent helper file (auto-generated by `next dev`)
frontend/AGENTS.md

# Environment / secrets (never commit credentials)
.env
.env.*
!.env.example

# Key material / credential stores
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
id_ed25519*
.aws/
.npmrc
.vercel

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Personal CV / resume documents (keep local, never commit).
# Anchored to the repo root: an unanchored `cv/` also matches the CV UI folder
# at frontend/src/components/cv/ and would silently drop new files from git.
/cv/
